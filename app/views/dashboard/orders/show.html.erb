<%# Status badge helper %>
<% status_colors = {
  "pending"   => "bg-yellow-100 text-yellow-800",
  "approved"  => "bg-blue-100 text-blue-800",
  "shipped"   => "bg-indigo-100 text-indigo-800",
  "delivered" => "bg-green-100 text-green-800",
  "cancelled" => "bg-red-100 text-red-800"
} %>

<div class="flex items-center gap-3 mb-6">
  <%= link_to "← Orders", dashboard_orders_path, class: "text-sm text-gray-500 hover:underline" %>
  <h1 class="text-2xl font-bold"><%= @order.reference %></h1>
  <span class="px-2 py-0.5 rounded-full text-sm font-medium <%= status_colors[@order.status] %>">
    <%= @order.status.capitalize %>
  </span>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6">
  <%# Main info %>
  <div class="lg:col-span-2 space-y-6">

    <%# Customer & Details %>
    <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
      <h2 class="font-semibold text-gray-700 mb-4">Order Details</h2>
      <dl class="grid grid-cols-2 gap-4 text-sm">
        <div>
          <dt class="text-gray-400">Customer</dt>
          <dd class="font-medium"><%= @order.customer_name %></dd>
        </div>
        <div>
          <dt class="text-gray-400">Email</dt>
          <dd><%= @order.customer_email %></dd>
        </div>
        <div>
          <dt class="text-gray-400">Tracking #</dt>
          <dd class="font-mono"><%= @order.tracking_number.presence || "—" %></dd>
        </div>
        <div>
          <dt class="text-gray-400">Carrier</dt>
          <dd><%= @order.carrier.presence || "—" %></dd>
        </div>
        <div>
          <dt class="text-gray-400">Created by</dt>
          <dd><%= @order.user.display_name %></dd>
        </div>
        <div>
          <dt class="text-gray-400">Total</dt>
          <dd class="font-bold text-lg">$<%= "%.2f" % @order.total_dollars %></dd>
        </div>
      </dl>
      <% if @order.notes.present? %>
        <div class="mt-4 pt-4 border-t border-gray-100">
          <dt class="text-gray-400 text-sm mb-1">Notes</dt>
          <dd class="text-sm"><%= @order.notes %></dd>
        </div>
      <% end %>
    </div>

    <%# Line Items %>
    <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
      <h2 class="font-semibold text-gray-700 mb-4">Line Items</h2>
      <table class="min-w-full text-sm">
        <thead>
          <tr class="border-b border-gray-200">
            <th class="pb-2 text-left font-medium text-gray-500">Product</th>
            <th class="pb-2 text-right font-medium text-gray-500">Qty</th>
            <th class="pb-2 text-right font-medium text-gray-500">Unit Price</th>
            <th class="pb-2 text-right font-medium text-gray-500">Total</th>
          </tr>
        </thead>
        <tbody>
          <% @order.line_items.includes(:product).each do |item| %>
            <tr class="border-b border-gray-50">
              <td class="py-2"><%= item.product.name %></td>
              <td class="py-2 text-right"><%= item.quantity %></td>
              <td class="py-2 text-right">$<%= "%.2f" % (item.unit_price_cents / 100.0) %></td>
              <td class="py-2 text-right font-medium">$<%= "%.2f" % item.line_total_dollars %></td>
            </tr>
          <% end %>
        </tbody>
        <tfoot>
          <tr>
            <td colspan="3" class="pt-3 text-right font-semibold">Total</td>
            <td class="pt-3 text-right font-bold">$<%= "%.2f" % @order.total_dollars %></td>
          </tr>
        </tfoot>
      </table>
    </div>

    <%# Tracking Events %>
    <% if @tracking_events.any? %>
      <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
        <h2 class="font-semibold text-gray-700 mb-4">Tracking History</h2>
        <ol class="relative border-l border-gray-200 ml-2">
          <% @tracking_events.each do |event| %>
            <li class="mb-4 ml-4">
              <div class="absolute w-3 h-3 bg-indigo-400 rounded-full -left-1.5 top-1"></div>
              <p class="font-medium text-sm"><%= event.description.presence || event.status.humanize %></p>
              <p class="text-xs text-gray-400"><%= event.location %> · <%= event.occurred_at.strftime("%b %-d %Y, %H:%M") %></p>
            </li>
          <% end %>
        </ol>
      </div>
    <% end %>

  </div>

  <%# Sidebar: Actions & Audit %>
  <div class="space-y-6">

    <%# Actions %>
    <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
      <h2 class="font-semibold text-gray-700 mb-4">Actions</h2>
      <div class="space-y-2">
        <% if @order.can_transition_to?("approved") %>
          <%= button_to "Approve", approve_dashboard_order_path(@order), method: :post,
              class: "w-full bg-blue-600 hover:bg-blue-700 text-white text-sm font-medium py-2 px-4 rounded-md cursor-pointer" %>
        <% end %>

        <% if @order.can_transition_to?("shipped") %>
          <div class="space-y-1">
            <%= form_with url: ship_dashboard_order_path(@order), method: :post, local: true do |f| %>
              <%= f.text_field :tracking_number, placeholder: "Tracking number",
                  class: "w-full border border-gray-300 rounded-md px-3 py-1.5 text-sm mb-1" %>
              <%= f.text_field :carrier, placeholder: "Carrier (e.g. FedEx)",
                  class: "w-full border border-gray-300 rounded-md px-3 py-1.5 text-sm mb-1" %>
              <%= f.submit "Mark as Shipped",
                  class: "w-full bg-indigo-600 hover:bg-indigo-700 text-white text-sm font-medium py-2 px-4 rounded-md cursor-pointer" %>
            <% end %>
          </div>
        <% end %>

        <% if @order.can_transition_to?("delivered") %>
          <%= button_to "Mark as Delivered", deliver_dashboard_order_path(@order), method: :post,
              class: "w-full bg-green-600 hover:bg-green-700 text-white text-sm font-medium py-2 px-4 rounded-md cursor-pointer" %>
        <% end %>

        <% if @order.can_transition_to?("cancelled") %>
          <%= button_to "Cancel Order", cancel_dashboard_order_path(@order), method: :post,
              data: { confirm: "Cancel this order?" },
              class: "w-full bg-red-50 hover:bg-red-100 text-red-600 text-sm font-medium py-2 px-4 rounded-md cursor-pointer border border-red-200" %>
        <% end %>

        <% if @order.status == "shipped" && @order.tracking_number.present? %>
          <%= button_to "Sync Tracking", ship_dashboard_order_path(@order), method: :post,
              class: "w-full bg-gray-100 hover:bg-gray-200 text-gray-700 text-sm font-medium py-2 px-4 rounded-md cursor-pointer" %>
        <% end %>
      </div>
    </div>

    <%# Audit Log %>
    <div class="bg-white rounded-lg shadow-sm border border-gray-200 p-6">
      <h2 class="font-semibold text-gray-700 mb-4">Audit Log</h2>
      <% if @audit_entries.any? %>
        <ul class="space-y-3">
          <% @audit_entries.each do |entry| %>
            <li class="text-sm border-b border-gray-50 pb-2">
              <div class="flex justify-between items-start">
                <span class="font-medium text-gray-700"><%= entry.event.humanize %></span>
                <span class="text-xs text-gray-400"><%= entry.created_at.strftime("%b %-d, %H:%M") %></span>
              </div>
              <div class="text-gray-400 text-xs"><%= entry.whodunnit %></div>
              <% if entry.changes_data.present? && entry.changes_data["status"].present? %>
                <div class="text-xs text-gray-500 mt-0.5">
                  <%= entry.changes_data["status"][0] %> → <%= entry.changes_data["status"][1] %>
                </div>
              <% end %>
            </li>
          <% end %>
        </ul>
      <% else %>
        <p class="text-sm text-gray-400">No audit history yet.</p>
      <% end %>
    </div>

  </div>
</div>
